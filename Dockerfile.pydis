# This is a custom additional build of Snekbox that includes multiple Python versions.

# The Python versions are prebuilt python-build-standalone distributions,
# installed with uv to avoid having to build them from source.

ARG SNEKBOX_IMAGE=ghcr.io/python-discord/snekbox:latest
FROM ghcr.io/astral-sh/uv:latest AS uv
FROM ${SNEKBOX_IMAGE}

RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=source=scripts/install_python.sh,target=/install_python.sh \
    /install_python.sh 3.13 \
    && /install_python.sh 3.14 \
    && /install_python.sh 3.14t \
    && /install_python.sh 3.14j

RUN rm /snekbin/python/default && ln -s /snekbin/python/3.14/ /snekbin/python/default
